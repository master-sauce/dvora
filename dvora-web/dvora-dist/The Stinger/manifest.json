{
  "manifest_version": 3,
  "name": "Dvora's Stinger",
  "version": "1.1.0",
  "description": "Detect, capture, and download HLS/M3U8 streams as MP4",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dvora's Stinger"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/ffmpeg/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
